# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual env (local only; Colab deps live in requirements-train.txt)
.venv/

# Secrets / config
.env

# Raw postings are NEVER committed (ADR-0002): capture prose at collection time,
# freeze the processed dataset on HF Hub. Only prose-derived fields leave the machine.
data/raw/
*.db

# Model weights / quantized bases (downloaded on demand for the probe)
models/
data/models/
*.gguf
*.safetensors
*.bin

# Probe slice (prose-derived, replayed) and per-run predictions/reports — not committed;
# only the ADR numbers + a small offline fixture are versioned.
data/probe_slice.json
results/probe/

# S2 dataset: collected slice (replayed) + processed train/test — frozen on HF Hub, not git.
data/dataset_slice.json
data/processed/
data/*.log

# S3 labeling QA (ADR-0005): proposals (replayed), the review queue + human gold (may echo prose)
# are never committed — only the numbers-only report.{json,md} under results/labeling_qa/ is versioned.
results/labeling_qa/proposals.jsonl
results/labeling_qa/review_queue.jsonl
results/labeling_qa/human_gold.jsonl

# S4 eval (ADR-0003): per-run baseline predictions echo prose (parsed fields + tokens) — never
# committed; only the numbers-only results/eval/report.{json,md} is versioned.
results/eval/predictions/

# HF / MLflow local artifacts
mlruns/
.cache/

# CodeGraph index (user's decision to index)
.codegraph/

# Claude Code local session briefs / scratch (never committed — local working notes)
.claude/

# OS
.DS_Store
Thumbs.db
